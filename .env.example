# Admin authentication (required for /admin login)
# Local: copy to .env.local and restart npm run dev
# Vercel: Project → Settings → Environment Variables (then redeploy)
#
#   ADMIN_PASSWORD  — password you type on /admin/login
#   ADMIN_SECRET    — long random string for session signing (optional; falls back to ADMIN_PASSWORD)

ADMIN_PASSWORD="your-secure-password-here"
ADMIN_SECRET="your-long-random-secret-here"
