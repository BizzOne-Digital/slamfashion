# Admin authentication (required for /admin login)
# Local: copy to .env.local and restart npm run dev
# Vercel: Project → Settings → Environment Variables (then redeploy)

ADMIN_PASSWORD="your-secure-password-here"
ADMIN_SECRET="your-long-random-secret-here"

# MongoDB (required for live store data + image uploads)
MONGODB_DB_NAME="slamfashion"

# Option A — recommended on Windows if SRV DNS fails:
# Atlas → Connect → Drivers → copy STANDARD connection string (starts with mongodb://)
# MONGODB_STANDARD_URI="mongodb://user:pass@cluster0-shard-00-00.xxxxx.mongodb.net:27017,.../slamfashion?ssl=true&replicaSet=..."

# Option B — separate credentials (app builds the URI for you):
MONGODB_USERNAME="memoonctm_db_user"
MONGODB_PASSWORD="WAAdKJsRC2mp513W"
MONGODB_STANDARD_URI="mongodb+srv://memoonctm_db_user:WAAdKJsRC2mp513W@cluster0.2p7ygxv.mongodb.net"

# Option C — full SRV string (works when DNS allows mongodb+srv):
# MONGODB_URI="mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/slamfashion?retryWrites=true&w=majority"
